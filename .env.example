# Public site URL (canonical URLs, OG metadata and CSRF origin checks)
NEXT_PUBLIC_SITE_URL=https://nitinstechfolio.vercel.app

# Vercel Blob: created by `vercel storage create <name> --type blob --access public`
# and connected with `vercel storage connect <name>`. On Vercel these are injected
# automatically (OIDC); `@vercel/blob` reads VERCEL_OIDC_TOKEN + BLOB_STORE_ID.
# BLOB_STORE_ID=store_xxxxxxxx
# BLOB_PUBLIC_BASE_URL=https://xxxxxxxx.public.blob.vercel-storage.com
# VERCEL_OIDC_TOKEN=...

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never commit these values.
# Generate with: openssl rand -base64 18 | tr -d '/+=' | cut -c1-24
RESUME_ADMIN_PASSWORD=replace-with-a-strong-random-password
# Generate with: openssl rand -hex 32
RESUME_SESSION_SECRET=replace-with-a-random-64-character-hex-string
