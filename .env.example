# Public site URL (used for canonical URLs, OG metadata and CSRF origin checks)
NEXT_PUBLIC_SITE_URL=https://your-production-url.vercel.app

# Supabase project settings (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never commit this value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Immutable Supabase Auth user UUID(s) allowed to manage resumes. Deny by default.
# Find this in Supabase -> Authentication -> Users -> user UUID.
RESUME_ADMIN_IDS=00000000-0000-0000-0000-000000000000

# Optional: email allowlist as an additional/transition mechanism.
# RESUME_ADMIN_EMAILS=owner@example.com
